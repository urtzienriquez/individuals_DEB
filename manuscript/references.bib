  title = {Australian Songbird Body Size Tracks Climate Variation: 82 Species over 50 Years},
  shorttitle = {Australian Songbird Body Size Tracks Climate Variation},
  author = {Gardner, Janet L. and Amano, Tatsuya and Peters, Anne and Sutherland, William J. and Mackey, Brendan and Joseph, Leo and Stein, John and Ikin, Karen and Little, Roellen and Smith, Jesse and Symonds, Matthew R. E.},
